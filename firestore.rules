rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'dhruvchavda7383@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'category', 'price', 'fabric', 'sizes', 'images', 'isVisible', 'createdAt']) &&
        data.id is string && data.id.size() <= 64 &&
        data.name is string && data.name.size() <= 200 &&
        data.slug is string && data.slug.size() <= 250 &&
        data.category is string && data.category.size() <= 50 &&
        data.price is number && data.price >= 0 &&
        data.fabric is string && data.fabric.size() <= 200 &&
        data.sizes is list && data.sizes.size() <= 20 &&
        data.images is list && data.images.size() <= 10 &&
        data.isVisible is bool;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderId', 'customer', 'items', 'subtotal', 'totalAmount', 'paymentScreenshotUrl', 'utrNumber', 'policyAccepted', 'orderStatus', 'createdAt']) &&
        data.id is string && data.id.size() <= 64 &&
        data.orderId is string && data.orderId.size() <= 64 &&
        data.customer is map &&
        data.customer.name is string && data.customer.name.size() <= 100 &&
        data.customer.phone is string && data.customer.phone.size() <= 15 &&
        data.customer.address is string && data.customer.address.size() <= 300 &&
        data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
        data.subtotal is number && data.subtotal >= 0 &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.paymentScreenshotUrl is string && data.paymentScreenshotUrl.size() <= 1000 &&
        data.utrNumber is string && data.utrNumber.size() <= 30 &&
        data.policyAccepted == true &&
        data.orderStatus in ['Payment Pending', 'Payment Received', 'Packed', 'Shipped', 'Delivered', 'Cancelled'];
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (resource.data.isVisible == true || isAdmin());
      allow list: if resource.data.isVisible == true || isAdmin();
      allow create, update: if isAdmin() && isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow update, delete: if isAdmin() && isValidId(orderId);
    }

    match /orderTracking/{trackingId} {
      allow get: if isValidId(trackingId);
      allow list: if isAdmin();
      allow create: if isValidId(trackingId);
      allow update, delete: if isAdmin() && isValidId(trackingId);
    }

    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isAdmin() && isValidId(settingId);
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}

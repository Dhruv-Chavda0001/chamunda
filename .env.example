# Chamunda Fashion - Environment Configuration
# Copy this file to .env and fill in your values

# Firebase Configuration (From Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# EmailJS Configuration (From emailjs.com -> Free tier)
# 1. Sign up free at https://www.emailjs.com/
# 2. Add Email Service (e.g. Gmail) -> get Service ID
# 3. Create Email Template -> get Template ID
# 4. Account -> API Keys -> get Public Key
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""

# Application URL
APP_URL="https://chamundafashion.in"
